# Copy to .env and fill in values. Loaded at startup by internal/envfile.
# Real environment variables always take priority over values in this file.

# Shared bearer token Miranda presents to call medical-card tools.
# Generate with: openssl rand -hex 32
MEDICAL_CARD_MCP_TOKEN=

# Google AI (Gemini) API keys — used for OCR, Structured Extraction,
# Planner, Answer Generator, and Embeddings. Multiple keys enable automatic
# rotation on rate limits (see internal/config.LLMConfig.APIKeyEnvs); a
# single key is enough to run the service.
# Get one at https://aistudio.google.com/apikey — free tier is sufficient.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
