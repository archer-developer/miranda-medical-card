# miranda-medical-card configuration template.
#
# This .dist file documents every available field with its built-in default
# (see internal/config.Default()) and is checked into git; it is never
# loaded directly. To configure a real deployment, copy it to
# config/config.yaml (or split it into several config/*.yaml files) and edit
# only what needs to differ — every config/*.yaml file is gitignored except
# this one. Full merge semantics (which files get loaded, in what order, how
# they combine): see internal/config's package doc comment and
# cmd/miranda-medical-card/main.go's configFilePaths.
#
# Secrets themselves never go in a config file, this one included — only the
# *name* of an environment variable to read them from at startup (fields
# ending in _env/_envs). See .env.example.

# http_addr: ":8791"
# auth_token_env: "MEDICAL_CARD_MCP_TOKEN"

# public_base_url: the externally reachable http(s) origin (scheme + host +
# port, no trailing slash) Miranda uses to reach this service — e.g. an SSH
# tunnel endpoint or a local network address, whatever the real deployment
# topology is. Used to build the fileUri medical.get_document returns for a
# document's original file (docs/mcp/02-files.md §5) — Miranda fetches it
# with a plain HTTP GET against GET /files/{fileId}, bearer-auth-gated the
# same way as /mcp. Defaults to the loopback address matching
# http_addr/tls.hosts' own defaults; override for any real deployment
# reachable over anything but localhost.
# public_base_url: "https://miranda.local:8791"

# tls: on by default. The server generates and reuses its own self-signed
# certificate at cert_file/key_file on first start (see
# internal/tlscert.EnsureSelfSigned) rather than requiring a CA-issued one —
# this link never leaves localhost and has no public DNS name.
# tls:
#   enabled: true
#   cert_file: "data/tls/cert.pem"
#   key_file: "data/tls/key.pem"
#   hosts: ["127.0.0.1", "localhost"]

# database:
#   path: "data/medical-card.db"

# files: where uploaded document binaries are stored — see internal/filestore.
# max_size_bytes bounds how much medical.upload_document will fetch from a
# caller-supplied fileUri (see docs/mcp/03-documents.md §4).
# files:
#   dir: "data/files"
#   max_size_bytes: 52428800

# llm: every configured model backend (providers), and which one each of the
# three stages uses by name — ocr_provider runs Stage 1 (OCR/Vision) of the
# Document Pipeline; extraction_provider runs every Structured-shaped call
# the Document Pipeline makes (Structured Extraction Stage 2a/2b,
# Self-Reported Event extraction, decline matching, title backfill);
# agent_provider is the default/primary provider for the medical.ask agent
# loop (see internal/config.LLMConfig's doc comment). ocr_provider and
# extraction_provider are independent — they may name the same provider (the
# default below) or two different ones, e.g. to keep a Structured Extraction
# schema/prompt change off OCR's quota budget, or vice versa. Mirrors
# miranda's own config/llm.yaml providers/default_provider shape (see
# internal/config.ProviderConfig's doc comment) so the two formats stay
# directly comparable. api_key_envs supports several environment variables
# for automatic key rotation on rate limits — every provider type (gemini,
# anthropic, openai_compat) rotates across however many resolve to a set env
# var, retrying on quota (429) or a per-key auth failure (401/403) but never
# on a 5xx (every key would just hit the same struggling backend — see each
# miranda-llm package's isRetryable doc comment) — list as many as you have.
# The gemini_rotation key below tunes rotation for every provider type
# alike; the name is a historical holdover from when only gemini rotated.
#
# escalation means two different things depending on which stage the
# provider is configured for:
#   - ocr_provider/extraction_provider: content-based retry. For
#     extraction_provider, if Structured Extraction's own retries are
#     exhausted and the result still looks suspiciously empty (see
#     internal/extraction.StructuredWithRetry), one attempt is made against
#     escalation.target_provider instead of retrying extraction_provider
#     again — e.g. falling back from Gemini to Claude on a document Gemini
#     keeps missing. For ocr_provider, any hard OCR error retries once
#     against escalation.target_provider (see extraction.Extract's
#     ocrProvider/ocrEscalate parameters). Only target_provider is read
#     here; tool_name/description are ignored for these two stages.
#   - agent_provider (and every provider wired into its router.Router — see
#     cmd/miranda-medical-card/main.go, which builds the router over ALL
#     configured providers, not just this one): miranda-llm's tool-based Chat
#     escalation. When enabled and tool_name is set, the agent model may call
#     tool_name mid-conversation to hand a hard question off to
#     target_provider, and a hard provider failure mid-turn falls back to it
#     too — this now applies, since medical.ask is a genuine open multi-turn
#     Chat loop, unlike ocr_provider/extraction_provider's one-shot calls.
# llm:
#   providers:
#     - name: gemini-document
#       type: gemini
#       model: "gemini-3.6-flash"
#       api_key_envs: ["GEMINI_API_KEY_1"]
#       gemini_rotation:
#         cooldown_seconds: 30
#         max_retry_cycles: 1
#       escalation:
#         enabled: true
#         target_provider: "claude-escalation"
#     - name: gemini-agent
#       type: gemini
#       model: "gemini-3.6-flash"
#       api_key_envs: ["GEMINI_API_KEY_1"]
#       gemini_rotation:
#         cooldown_seconds: 30
#         max_retry_cycles: 1
#       escalation:
#         enabled: true
#         tool_name: "escalate_to_claude"
#         description: "Hand this question off to a more capable model when it needs deeper cross-referencing or careful clinical-safety judgment than you can confidently provide."
#         target_provider: "claude-escalation"
#     - name: claude-escalation
#       type: anthropic
#       model: "claude-sonnet-5"
#       api_key_envs: ["ANTHROPIC_API_KEY"]
#   ocr_provider: "gemini-document"
#   extraction_provider: "gemini-document"
#   agent_provider: "gemini-agent"

# embedding:
#   api_key_env: "GEMINI_API_KEY_1"
#   model: "gemini-embedding-2"

# search:
#   default_limit: 10
#   max_limit: 50

# users has no built-in default and MUST be set: the closed list of
# household members every tool call's userId is checked against (see
# docs/architecture/01-overview.md §4). Left unset, the service refuses to
# start rather than run with no allowlist at all. shared_with grants other
# listed users read-only access (docs/domain/02-user.md §4); encryption and
# a non-empty shared_with are mutually exclusive. This repo's own template
# intentionally does not hardcode real household member ids — set the real
# list only in the server's own config.yaml, e.g.:
# users:
#   - id: "alex"
#     display_name: "Alexander"
#     birth_date: "1988-04-12"
#     sex: "male"
#     language: "ru"  # Nutrition Advisor writes restrictions/recommendations in this language (ISO 639-1 code or plain name, either works), see docs/adr/006-nutrition-guidance.md; omit to let it infer from the input instead
#   - id: "kid"
#     display_name: "Kid"
#     birth_date: "2020-01-01"
#     shared_with: ["alex"]  # parents can read the kid's data
#     encryption: false

logging:
  # At "debug", mirrors LLM request/response traces into logs/llm.log and
  # everything below info into logs/debug.log; both rotate by size.
  level: "info"
  max_size_mb: 10
  max_backups: 5
  max_age_days: 30

# backup: off by default — there's no safe auto-detected dir (see below).
# When enabled, internal/backup periodically snapshots database.path (via
# SQLite's VACUUM INTO, safe to run against a live connection) and
# recursively copies files.dir (the filestore's uploaded document binaries)
# into a timestamped subdirectory of dir, alongside a copy of every
# config/*.yaml file and .env (needed to actually restore a working
# deployment from the backup alone). data/tls's self-signed certificate/key
# are deliberately not included — they're regenerated automatically on
# startup if missing. Older timestamped subdirectories beyond
# retention_count are pruned after each successful run.
#
# `miranda-medical-card backup` also runs one backup cycle on demand (using
# these same settings regardless of enabled) and exits, without starting the
# full service — handy right before a risky change or to sanity-check the
# config before trusting the ticker.
# backup:
#   enabled: false
#   # An absolute path onto a separately mounted disk is recommended — a
#   # backup that lives on the same disk as the data it backs up doesn't
#   # protect against losing that disk. A relative path (under the working
#   # directory) is also fine for local/dev use. Created automatically if
#   # missing.
#   dir: "/mnt/backup/miranda-medical-card"
#   interval_minutes: 1440  # once a day
#   retention_count: 7      # keep the 7 most recent backups; 0 = keep all
